# Body force, edge traction and pressure example. Q4 local edges are
# 1=n1-n2, 2=n2-n3, 3=n3-n4, 4=n4-n1; positive pressure acts inward.

[settings]
plane_mode plane_stress
solver pcg
tolerance 1.0e-10
max_iterations 5000
reordering rcm
assembly coloring
threads 2
output cantilever_extended_loads.vtk

[materials]
1 2.10e11 0.30 0.01

[nodes]
1 0.0 0.0
2 1.5 0.0
3 3.0 0.0
4 0.0 1.0
5 1.5 1.0
6 3.0 1.0

[elements]
1 1 2 5 4 1
2 2 3 6 5 1

[boundary]
1 fixed
4 fixed

[body_forces]
# Gravity-like load density in N/m^3.
1 0.0 -78500.0
2 0.0 -78500.0

[edge_loads]
# Downward surface traction on the top edges.
1 3 traction 0.0 -2.0e5
2 3 traction 0.0 -2.0e5
# Positive pressure on the free right edge acts inward (to the left).
2 2 pressure 1.0e5
