# OpenMP parallel example: use the same physical model as cantilever.fem.

[settings]
plane_mode plane_stress
solver pcg
tolerance 1.0e-10
max_iterations 5000
reordering rcm
assembly coloring
threads 2
output cantilever_parallel.vtk

[materials]
1 2.10e11 0.30 0.01

[nodes]
1 0.0 0.0
2 1.5 0.0
3 3.0 0.0
4 0.0 1.0
5 1.5 1.0
6 3.0 1.0

[elements]
1 1 2 5 4 1
2 2 3 6 5 1

[boundary]
1 0.0 0.0
4 0.0 0.0

[loads]
3 0.0 -500.0
6 0.0 -500.0
